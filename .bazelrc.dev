# Local Sensor Kit dependency checkouts from deps.repos. Import with:
#   vcs import pkgs < deps.repos
# Opt in with --config=dev.
common:dev --lockfile_mode=off

common:dev --override_module=wheelos_common=%workspace%/pkgs/common
common:dev --override_module=wheelos_core=%workspace%/pkgs/core
common:dev --override_module=wheelos_msgs=%workspace%/pkgs/wheelos_msgs
common:dev --override_module=wheelos_transform=%workspace%/pkgs/transform

common:dev --override_module=hardware.build=%workspace%/pkgs/hardware/build
common:dev --override_module=hardware.camera=%workspace%/pkgs/hardware/camera
common:dev --override_module=hardware.lidar=%workspace%/pkgs/hardware/lidar

build:dev --extra_toolchains=@@rules_foreign_cc+//toolchains:preinstalled_ninja_toolchain
