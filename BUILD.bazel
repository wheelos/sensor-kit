package(default_visibility = ["//visibility:public"])

exports_files(["MODULE.bazel"])

filegroup(
    name = "dependency_lock",
    srcs = glob(
        ["MODULE.bazel.lock"],
        allow_empty = True,
    ),
)

alias(
    name = "mainboard",
    actual = "@wheelos_core//cyber/mainboard:mainboard",
)

alias(
    name = "cyber_launch",
    actual = "@wheelos_core//cyber/tools/cyber_launch:cyber_launch",
)

alias(
    name = "cyber_recorder",
    actual = "@wheelos_core//tools:cyber_recorder",
)

alias(
    name = "cyber_monitor",
    actual = "@wheelos_core//tools:cyber_monitor",
)

filegroup(
    name = "sensor_runtime_tools",
    srcs = [
        ":cyber_launch",
        ":cyber_monitor",
        ":cyber_recorder",
        ":mainboard",
    ],
)
