# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
*.so.*

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Build directories
# Bazel source rules are maintained in /build.
!/build/
Build/
build-*/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# Temporary files
*.tmp
*.log
*.bak
*.swp

# Core runtime (glog) output
*.INFO
*.WARNING
*.ERROR
*.FATAL
*.log.INFO.*
*.log.WARNING.*
*.log.ERROR.*
*.log.FATAL.*

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
Testing/
.cache/

/bazel-*
__pycache__/
*.py[cod]

# Customer/local deployments and recorded data stay out of version control.
/deployment/local/

# Cyber middleware configuration symlink created by scripts/env.sh.
/conf

# Source checkouts imported from deps.repos are managed independently.
/pkgs/
