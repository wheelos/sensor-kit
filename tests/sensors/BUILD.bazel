load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_python//python:defs.bzl", "py_test")
load("//build:runtime.bzl", "runtime_layout", "runtime_module")

package(default_visibility = ["//visibility:private"])

cc_binary(
    name = "libsynthetic_sensor.so",
    testonly = True,
    srcs = ["synthetic_sensor.cc"],
    linkshared = True,
    linkstatic = False,
    deps = [
        "@wheelos_core//cyber",
        "@wheelos_msgs//wheelos_msgs/sensor_msgs:sensor_image_cc_proto",
    ],
)

cc_binary(
    name = "record_probe",
    testonly = True,
    srcs = ["record_probe.cc"],
    deps = [
        "@wheelos_core//cyber/record:record_reader",
        "@wheelos_msgs//wheelos_msgs/sensor_msgs:sensor_image_cc_proto",
    ],
)

runtime_module(
    name = "module",
    testonly = True,
    components = [":libsynthetic_sensor.so"],
    files = {
        "synthetic.dag": "modules/sensors/dag/synthetic.dag",
        "synthetic.launch": "modules/sensors/launch/sensors.launch",
    },
    module_name = "sensors",
    visibility = ["//visibility:public"],
)

runtime_layout(
    name = "synthetic_runtime",
    testonly = True,
    modules = [":module"],
)

runtime_module(
    name = "selected_plugins",
    testonly = True,
    components = select({
        "//products/sensors:camera": ["@hardware.camera//:component"],
        "//products/sensors:lidar": ["@hardware.lidar//:hesai"],
        "//products/sensors:combined": [
            "@hardware.camera//:component",
            "@hardware.lidar//:hesai",
        ],
        "//conditions:default": [],
    }),
    files = {
        "//tests/sensors/fixtures:camera": "modules/sensors/conf/camera.pb.txt",
        "//tests/sensors/fixtures:lidar": "modules/sensors/conf/lidar.pb.txt",
    },
    module_name = "sensors",
)

runtime_layout(
    name = "selected_runtime",
    testonly = True,
    modules = [":selected_plugins"],
)

py_test(
    name = "integration",
    size = "medium",
    timeout = "short",
    srcs = ["integration_test.py"],
    args = [
        "$(rlocationpath :synthetic_runtime)",
        "$(rlocationpath :record_probe)",
        "$(rlocationpath :selected_runtime)",
    ],
    data = [
        ":record_probe",
        ":selected_runtime",
        ":synthetic_runtime",
    ],
    main = "integration_test.py",
    tags = [
        "exclusive",
        "manual",
    ],
    deps = ["@rules_python//python/runfiles"],
)
