load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@rules_pkg//pkg:install.bzl", "pkg_install")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//build:runtime.bzl", "required_input", "runtime_layout", "runtime_module", "runtime_package", "runtime_run")

package(default_visibility = ["//visibility:public"])

exports_files([
    "camera.dag",
    "lidar.dag",
    "sensors.launch",
])

string_flag(
    name = "selection",
    build_setting_default = "none",
    values = [
        "none",
        "camera",
        "lidar",
        "combined",
    ],
)

[
    config_setting(
        name = choice,
        flag_values = {":selection": choice},
    )
    for choice in [
        "camera",
        "lidar",
        "combined",
    ]
]

required_input(
    name = "selection_required",
    message = "Choose --config=sensors-camera, sensors-lidar or sensors-combined.",
)

required_input(
    name = "configuration_required",
    message = "Supply camera_config/lidar_config label flags with reviewed device configuration files.",
)

label_flag(
    name = "camera_config",
    build_setting_default = ":configuration_required",
)

label_flag(
    name = "lidar_config",
    build_setting_default = ":configuration_required",
)

runtime_module(
    name = "module",
    components = select({
        ":camera": ["@hardware.camera//:component"],
        ":lidar": ["@hardware.lidar//:hesai"],
        ":combined": [
            "@hardware.camera//:component",
            "@hardware.lidar//:hesai",
        ],
        "//conditions:default": [":selection_required"],
    }),
    files = select({
        ":camera": {
            ":camera_config": "modules/sensors/conf/camera.pb.txt",
            "camera.dag": "modules/sensors/dag/camera.dag",
            "camera.launch": "modules/sensors/launch/sensors.launch",
        },
        ":lidar": {
            ":lidar_config": "modules/sensors/conf/lidar.pb.txt",
            "lidar.dag": "modules/sensors/dag/lidar.dag",
            "lidar.launch": "modules/sensors/launch/sensors.launch",
        },
        ":combined": {
            ":camera_config": "modules/sensors/conf/camera.pb.txt",
            ":lidar_config": "modules/sensors/conf/lidar.pb.txt",
            "camera.dag": "modules/sensors/dag/camera.dag",
            "lidar.dag": "modules/sensors/dag/lidar.dag",
            "sensors.launch": "modules/sensors/launch/sensors.launch",
        },
        "//conditions:default": {},
    }),
    module_name = "sensors",
)

runtime_layout(
    name = "runtime",
    modules = [":module"],
)

runtime_package(
    name = "package_files",
    runtime = ":runtime",
)

runtime_run(
    name = "run",
    runtime = ":runtime",
)

pkg_tar(
    name = "package",
    srcs = [":package_files"],
    extension = "tar.gz",
    package_file_name = "runtime.tar.gz",
)

pkg_install(
    name = "install",
    srcs = [":package_files"],
)
